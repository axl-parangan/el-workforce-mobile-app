# Copy to .env and adjust. Never commit .env.
# Placeholder values only. Generate a real secret key with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"

# --- Django -------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me
# Comma-separated. Local settings default to "*" when unset.
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Browser origins only (Expo web, future admin web). Native apps ignore CORS.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
DJANGO_LOG_LEVEL=INFO
# console | json
DJANGO_LOG_FORMAT=console

# --- Business configuration ---------------------------------------------------
# IANA timezone that defines work dates for attendance and payroll.
COMPANY_TIME_ZONE=America/Toronto
# GPS fixes less accurate than this are flagged for review.
LOCATION_MAX_ACCURACY_METERS=30
# Device times further ahead of server time than this are flagged for review.
ATTENDANCE_FUTURE_TOLERANCE_SECONDS=300
# Admin/Manager entries for other employees older than this are refused (no backdating).
ATTENDANCE_ADMIN_ENTRY_MAX_AGE_SECONDS=900

# --- JWT ----------------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
# Must exceed the longest expected offline period of a device.
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=construction_workforce
POSTGRES_USER=construction
POSTGRES_PASSWORD=change-me
# Used when running Django on the host. docker-compose overrides these to db:5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Docker Compose host ports / user mapping -----------------------------------
POSTGRES_HOST_PORT=5432
BACKEND_HOST_PORT=8000
# Set to the output of `id -u` / `id -g` if they are not 1000.
APP_UID=1000
APP_GID=1000
