# Copy to mobile/.env.local (gitignored). EXPO_PUBLIC_* values are inlined into
# the JS bundle at build time, so never put secrets here.

# Base URL of the versioned API, including /api/v1.
#   iOS simulator / web:      http://localhost:8000/api/v1
#   Android emulator:         http://10.0.2.2:8000/api/v1
#   Physical device (LAN):    http://<your-computer-LAN-IP>:8000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
